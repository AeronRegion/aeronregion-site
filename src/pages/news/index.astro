---
import Base from '../../layouts/Base.astro';
import NewsList from '../../components/NewsList.astro';
import { posts } from '../../lib/news';
---
<Base title="News" description="News and updates from Aeron Region.">
  <section class="wrap page">
    <h1>News</h1>
    <p class="soft">Server updates, events, tournaments, and pack changes.</p>
    <NewsList posts={posts} />
  </section>
</Base>

<style>
  .page { padding-top: 3.5rem; max-width: 820px; }
  .soft { margin-bottom: 2rem; }
</style>
