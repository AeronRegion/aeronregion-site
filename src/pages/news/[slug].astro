---
import Base from '../../layouts/Base.astro';
import { posts, fmtDate } from '../../lib/news';

export function getStaticPaths() {
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}
const { post } = Astro.props;
const { Content } = post;
---
<Base title={post.title} description={post.summary}>
  <article class="wrap post">
    <p><a href="/news/">Back to news</a></p>
    <h1>{post.title}</h1>
    <p class="soft">{fmtDate(post.date)}{post.tag && `, ${post.tag}`}</p>
    {post.image && <img class="cover" src={post.image} alt="" />}
    <div class="prose"><Content /></div>
  </article>
</Base>

<style>
  .post { padding-top: 3rem; max-width: 820px; }
  .cover { border: 4px solid var(--ink); margin: 1.5rem 0 2rem; aspect-ratio: 21/9; object-fit: cover; width: 100%; }
</style>
