---
import Base from '../layouts/Base.astro';
import WorldRow from '../components/WorldRow.astro';
import { worlds } from '../config/worlds';
---
<Base title="World Downloads" description="Download archived Aeron Region worlds.">
  <section class="wrap head">
    <h1>Select world</h1>
    <p class="soft">Every world we've run, free to download. Install the listed modpack version first, unzip the world, and put the folder in your <code>saves</code> folder.</p>
  </section>

  <section class="wrap">
    <ul class="list">
      {worlds.map((w) => <WorldRow world={w} />)}
    </ul>
  </section>
</Base>

<style>
  .head { padding-top: 3.5rem; }
  .head p { max-width: 62ch; }
  .list {
    list-style: none; margin: 1.5rem 0 0; padding: .75rem;
    background: #1e1416; border: 4px solid var(--ink);
    box-shadow: inset 0 0 0 2px #4a3a3d;
    display: flex; flex-direction: column; gap: .25rem;
  }
</style>
