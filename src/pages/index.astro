---
import Base from '../layouts/Base.astro';
import ServerStatus from '../components/ServerStatus.astro';
import NewsList from '../components/NewsList.astro';
import Icon from '../components/Icon.astro';
import { site, mainServer, socials, stores, experimental } from '../config/site';
import { posts } from '../lib/news';
const latest = posts.slice(0, 4);
const discord = socials.find((s) => s.icon === 'discord')!;
const challonge = socials.find((s) => s.icon === 'trophy')!;
---
<Base>
  <!-- HERO: the community screenshot, with the name floating above the crowd like a nametag. -->
  <section class="hero">
    <img class="shot" src="/images/hero.webp" alt="Aeron Region players gathered in the cherry-blossom town" fetchpriority="high" />
    <div class="dock">
      <div class="wrap">
        <h1 class="title"><span class="nametag">{site.name}</span></h1>
        <p class="sub"><span class="nametag">{site.tagline}</span></p>
      </div>
      <div class="wrap dock-inner">
        <ServerStatus ip={mainServer.ip} statusHost={mainServer.statusHost} />
        <div class="actions">
          <a class="block" href={discord.href} target="_blank" rel="noopener"><Icon name="discord" size={18} /> Join the Discord</a>
          <a class="block stone" href={stores[0].href} target="_blank" rel="noopener"><Icon name="cart" size={18} /> Store</a>
        </div>
      </div>
    </div>
  </section>

  <section class="wrap split">
    <div class="intro">
      <p class="lede">{mainServer.pack} {mainServer.packVersion}, with a gym league, tournaments, and a second modded server that tries a new modpack every month. Apply for your own gym, challenge the league, or just build something nice with a community.</p>
      <p><a href={challonge.href} target="_blank" rel="noopener">Tournament brackets on Challonge</a></p>

      {latest.length > 0 && (
        <>
          <h2>News</h2>
          <NewsList posts={latest} />
          <p><a href="/news/">All news</a></p>
        </>
      )}
    </div>

    <aside class="side">
      <div class="panel pixel-corners" id="modpacks">
        <h2>Get the modpacks</h2>
        <p class="soft">Install the modpack in your launcher, then join with the server address.</p>

        <div class="pack">
          <p class="now">Main server<br /><strong>{mainServer.pack} {mainServer.packVersion}</strong></p>
          <code class="addr">{mainServer.ip}</code>
          <div class="dl">
            {mainServer.modrinth && <a class="block" href={mainServer.modrinth} target="_blank" rel="noopener"><Icon name="download" size={18} /> Modrinth</a>}
            {mainServer.curseforge && <a class="block stone" href={mainServer.curseforge} target="_blank" rel="noopener">CurseForge</a>}
          </div>
        </div>

        <div class="pack">
          <p class="now">Experimental server<br /><strong>{experimental.current.name} {experimental.current.version}</strong></p>
          <code class="addr">{experimental.ip}</code>
          {experimental.requestAccess && <p class="soft small"><a href={experimental.accessLink} target="_blank" rel="noopener">Request access</a> in our Discord to join.</p>}
          <div class="dl">
            {experimental.current.modrinth && <a class="block" href={experimental.current.modrinth} target="_blank" rel="noopener"><Icon name="download" size={18} /> Modrinth</a>}
            {experimental.current.curseforge && <a class="block stone" href={experimental.current.curseforge} target="_blank" rel="noopener">CurseForge</a>}
          </div>
          <p class="small"><a href="/experimental/">About the experimental server</a></p>
        </div>
      </div>

      <div class="panel archive pixel-corners">
        <h2>World archive</h2>
        <p class="soft">Download our past worlds and explore them in singleplayer.</p>
        <a class="block stone" href="/worlds/"><Icon name="download" size={18} /> Browse worlds</a>
      </div>
    </aside>
  </section>

  {mainServer.trailer && (
    <section class="wrap trailer">
      <h2>Official Trailer</h2>
      <div class="frame">
        <iframe src={mainServer.trailer} title="Aeron Region trailer" loading="lazy"
          allow="accelerometer; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
      </div>
    </section>
  )}
</Base>

<style>
  .hero { position: relative; height: min(86vh, 780px); min-height: 520px; overflow: hidden; background: var(--brick-deep); }
  .shot { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center 65%; }
  .dock { position: absolute; left: 0; right: 0; bottom: 0; padding: 6rem 0 1.5rem;
    background: linear-gradient(0deg, rgb(53 24 32 / .96) 0%, rgb(53 24 32 / .8) 45%, transparent 100%); }
  .title { margin: 0 0 0 -.3em; font-size: clamp(2.8rem, 8vw, 6rem); font-weight: 700; }
  .title .nametag, .sub .nametag { background: rgb(0 0 0 / .55); text-shadow: 3px 3px 0 rgb(0 0 0 / .5); }
  .title .nametag { padding: .02em .3em .08em; }
  .sub { margin: .6rem 0 1.4rem -.45em; font-size: clamp(1.3rem, 2.6vw, 1.9rem); }
  .sub .nametag { padding: .1em .45em .15em; font-family: var(--font-ui); font-weight: 700; }
  .dock-inner { display: flex; justify-content: space-between; align-items: center; gap: 1rem; flex-wrap: wrap; }
  .actions { display: flex; gap: .75rem; flex-wrap: wrap; }

  .split { display: grid; grid-template-columns: minmax(0, 1fr) 340px; gap: 3.5rem; margin-top: 3.5rem; }
  .lede { font-size: 1.3rem; line-height: 1.5; max-width: 34ch; }
  .intro h2 { margin-top: 2.5rem; }

  .side { display: flex; flex-direction: column; gap: 1.5rem; }
  .panel { background: var(--brick); color: var(--on-brick); padding: 1.5rem; }
  .panel h2 { font-size: 1.5rem; margin-bottom: .4rem; }
  .panel .soft { color: var(--on-brick-soft); }
  .panel a:not(.block) { color: var(--blossom); }
  .now { font-family: var(--font-ui); color: var(--on-brick-soft); }
  .now strong { color: #fff; font-size: 1.2rem; font-weight: 600; }
  .archive { background: var(--brick-deep); }
  .pack { border-top: 2px solid var(--brick-deep); padding-top: 1rem; margin-top: 1rem; }
  .pack .now { margin-bottom: .4rem; }
  .addr { display: inline-block; font-family: var(--font-ui); background: rgb(0 0 0 / .3); padding: .1rem .5rem; margin-bottom: .75rem; }
  .dl { display: flex; gap: .5rem; flex-wrap: wrap; }
  .dl .block { font-size: 1rem; padding: .45rem .85rem; }
  .small { font-size: .92rem; margin: .6rem 0 0; }

  .trailer { margin-top: 4.5rem; }
  .frame { aspect-ratio: 16/9; border: 4px solid var(--ink); background: #000; }
  .frame iframe { width: 100%; height: 100%; border: 0; display: block; }

  @media (max-width: 880px) {
    .split { grid-template-columns: 1fr; gap: 2.5rem; }
    .shot { object-position: 45% 65%; }
    .title, .sub { margin-left: 0; }
  }
</style>
