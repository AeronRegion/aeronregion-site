---
import Base from '../layouts/Base.astro';
import ServerStatus from '../components/ServerStatus.astro';
import NewsCard from '../components/NewsCard.astro';
import Icon from '../components/Icon.astro';
import { site, mainServer, socials, stores, experimental } from '../config/site';
import { posts } from '../lib/news';
const latest = posts.slice(0, 3);
const discord = socials.find((s) => s.icon === 'discord')!;
---
<Base>
  <!-- HERO — community screenshot. Characters sit in the lower half, so the image is anchored low. -->
  <section class="hero">
    <img class="hero-img" src="/images/hero.webp" alt="Aeron Region players gathered in the cherry-blossom town" fetchpriority="high" />
    <div class="hero-shade"></div>
    <div class="container hero-content">
      <div class="eyebrow">Cobblemon · {mainServer.pack} {mainServer.packVersion}</div>
      <h1>{site.name}</h1>
      <p class="lead">{site.tagline}</p>
      <ServerStatus ip={mainServer.ip} />
      <div class="actions">
        <a class="btn btn-primary" href={discord.href} target="_blank" rel="noopener"><Icon name="discord" /> Join the Discord</a>
        <a class="btn btn-ghost" href={stores[0].href} target="_blank" rel="noopener"><Icon name="cart" /> Store</a>
      </div>
    </div>
  </section>

  <!-- QUICK LINKS -->
  <section class="container quick">
    <a href="/worlds/" class="card q">
      <div class="eyebrow">Archive</div>
      <h3>World downloads</h3>
      <p class="muted">Grab past worlds from every season and pack we've run.</p>
    </a>
    <a href="/experimental/" class="card q">
      <div class="eyebrow">Server 2</div>
      <h3>Experimental</h3>
      <p class="muted">Now playing: {experimental.current.name}. New pack roughly every month, by vote.</p>
    </a>
    <a href={socials.find((s) => s.icon === 'trophy')!.href} target="_blank" rel="noopener" class="card q">
      <div class="eyebrow">Compete</div>
      <h3>Gym league & tournaments</h3>
      <p class="muted">Brackets and results on our Challonge community.</p>
    </a>
  </section>

  <!-- NEWS -->
  {latest.length > 0 && (
    <section class="container section">
      <div class="row">
        <h2>Latest news</h2>
        <a href="/news/">All news →</a>
      </div>
      <div class="grid">{latest.map((p) => <NewsCard post={p} />)}</div>
    </section>
  )}

  <!-- TRAILER -->
  {mainServer.trailer && (
    <section class="container section">
      <h2>Official trailer</h2>
      <div class="video card">
        <iframe src={mainServer.trailer} title="Aeron Region trailer" loading="lazy"
          allow="accelerometer; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
      </div>
    </section>
  )}
</Base>

<style>
  .hero { position: relative; min-height: min(88vh, 760px); display: flex; align-items: flex-end; overflow: hidden; }
  .hero-img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center 62%; }
  .hero-shade {
    position: absolute; inset: 0;
    background:
      linear-gradient(90deg, rgb(23 13 17 / .85) 0%, rgb(23 13 17 / .35) 45%, transparent 75%),
      linear-gradient(0deg, var(--bg) 0%, rgb(23 13 17 / .2) 35%, transparent 60%);
  }
  .hero-content { position: relative; padding: 6rem 0 4rem; max-width: var(--max-w); }
  .hero h1 { text-shadow: 0 4px 24px rgb(0 0 0 / .6); color: #fff; margin-bottom: .2em; }
  .lead { font-size: 1.2rem; max-width: 34ch; margin: 0 0 1.5rem; text-shadow: 0 2px 12px rgb(0 0 0 / .7); }
  .actions { display: flex; gap: .75rem; flex-wrap: wrap; margin-top: 1.25rem; }

  .quick { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.25rem; margin-top: -1.5rem; position: relative; }
  .q { padding: 1.4rem; text-decoration: none; color: var(--text); transition: border-color .15s, transform .15s; }
  .q:hover { border-color: var(--primary); transform: translateY(-2px); color: var(--text); }
  .q h3 { margin-bottom: .3rem; }
  .q p { margin: 0; font-size: .95rem; }

  .row { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 1.25rem; }
  .video { aspect-ratio: 16/9; }
  .video iframe { width: 100%; height: 100%; border: 0; }

  @media (max-width: 820px) {
    .quick { grid-template-columns: 1fr; margin-top: 1rem; }
    .hero-img { object-position: 40% 62%; }
  }
</style>
