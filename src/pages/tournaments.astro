---
import Base from '../layouts/Base.astro';
import Slideshow from '../components/Slideshow.astro';
import Icon from '../components/Icon.astro';
import { socials } from '../config/site';
import { challonge, slides, latest } from '../config/tournaments';
const discord = socials.find((s) => s.icon === 'discord')!;
---
<Base title="Tournaments" description="Aeron Region tournaments: brackets, results, and photos from the arena.">
  <section class="wrap head">
    <h1>Tournaments</h1>
    <p class="intro">We run doubles tournaments in our battle arena, with brackets on Challonge. Sign-ups and announcements happen in Discord.</p>
    <div class="actions">
      <a class="block" href={challonge} target="_blank" rel="noopener"><Icon name="trophy" size={18} /> Brackets on Challonge</a>
      <a class="block stone" href={discord.href} target="_blank" rel="noopener"><Icon name="discord" size={18} /> Sign up in Discord</a>
    </div>
  </section>

  <section class="wrap">
    <Slideshow slides={slides} label="Tournament photos" />
  </section>

  <section class="wrap results">
    <div>
      <h2>{latest.name}</h2>
      <p class="soft">{latest.date}, {latest.format.toLowerCase()}</p>
      <ol class="podium">
        {latest.podium.map((p) => (
          <li><span class="place">{p.place}</span><span class="player">{p.player}</span></li>
        ))}
      </ol>
      <a href={latest.bracketLink} target="_blank" rel="noopener">See the full bracket on Challonge</a>
    </div>
    <a class="bracket" href={latest.bracketImage} target="_blank" rel="noopener" title="Open full size">
      <img src={latest.bracketImage} alt={`${latest.name} bracket`} loading="lazy" />
    </a>
  </section>
</Base>

<style>
  .head { padding-top: 3.5rem; padding-bottom: 1.75rem; }
  .intro { max-width: 58ch; font-size: 1.15rem; }
  .actions { display: flex; gap: .75rem; flex-wrap: wrap; }
  .results { display: grid; grid-template-columns: 280px 1fr; gap: 2.5rem; margin-top: 3.5rem; align-items: start; }
  .podium { list-style: none; padding: 0; margin: 1rem 0 1.25rem; }
  .podium li { display: flex; gap: 1rem; align-items: baseline; padding: .6rem 0; border-top: 2px solid var(--ink); }
  .podium li:last-child { border-bottom: 2px solid var(--ink); }
  .place { font-family: var(--font-ui); font-weight: 700; width: 2.5rem; color: var(--ink-soft); }
  .player { font-family: var(--font-ui); font-weight: 700; font-size: 1.25rem; }
  .podium li:first-child .player { font-size: 1.5rem; }
  .bracket { display: block; border: 4px solid #000; background: #2b2b2b; }
  .bracket img { width: 100%; }
  @media (max-width: 880px) { .results { grid-template-columns: 1fr; } }
</style>
