---
import Base from '../layouts/Base.astro';
import ServerStatus from '../components/ServerStatus.astro';
import Icon from '../components/Icon.astro';
import { experimental, stores } from '../config/site';
const c = experimental.current;
const since = new Date(c.since + '-01T00:00:00Z').toLocaleDateString('en-US', { month: 'long', year: 'numeric', timeZone: 'UTC' });
---
<Base title="Experimental Server" description={`Now playing ${c.name}. A new modpack every month or so, chosen by community vote.`}>
  <section class="now">
    <div class="wrap">
      {c.banner && <img class="banner" src={c.banner} alt={`${c.name} logo`} />}
      <div class="info">
        <div>
          <p class="label">Experimental server, playing since {since}</p>
          <h1>{c.name}</h1>
          <p class="meta">Version {c.version}, {c.loader}</p>
          <ServerStatus ip={experimental.ip} statusHost={experimental.statusHost} />
        </div>
        <div class="join">
          {experimental.requestAccess && (
            <a class="block" href={experimental.accessLink} target="_blank" rel="noopener"><Icon name="discord" size={18} /> Request access</a>
          )}
          <div class="row">
            {c.modrinth && <a class="block stone" href={c.modrinth} target="_blank" rel="noopener">Modrinth</a>}
            {c.curseforge && <a class="block stone" href={c.curseforge} target="_blank" rel="noopener">CurseForge</a>}
          </div>
          <a class="store" href={stores[1].href} target="_blank" rel="noopener"><Icon name="cart" size={16} /> Experimental store</a>
        </div>
      </div>
    </div>
  </section>

  <section class="wrap cols">
    <div>
      <h2>How it works</h2>
      <p>Our second server runs a different modpack every month or so. To join, request access in our Discord.</p>
      <p>Near the end of each pack, we post a poll in Discord and the community picks the next one.</p>
      <p>Ranks and purchases from the experimental store carry over when the pack changes. When a pack ends, its world goes into the <a href="/worlds/">world archive</a>.</p>
      <a class="block" href={experimental.pollLink} target="_blank" rel="noopener"><Icon name="discord" size={18} /> Vote in Discord</a>
    </div>
    <div>
      <h2>Past packs</h2>
      {experimental.history.length === 0
        ? <p class="soft">This is the first pack. Each one we finish will be listed here.</p>
        : (
          <ol class="past">
            {experimental.history.map((h: any) => (
              <li><strong>{h.name}</strong> <span class="soft">{h.version}, {h.from} to {h.to}</span></li>
            ))}
          </ol>
        )}
    </div>
  </section>
</Base>

<style>
  .now { padding-top: 2.5rem; }
  .banner { width: 100%; aspect-ratio: 1275/430; object-fit: cover; border: 4px solid var(--ink); }
  .info { display: grid; grid-template-columns: 1fr auto; gap: 2rem; align-items: end; margin-top: 1.75rem; }
  .label { font-family: var(--font-ui); font-weight: 600; color: var(--teal-ink); margin-bottom: .3rem; }
  .now h1 { margin-bottom: .4rem; font-size: clamp(1.9rem, 4.2vw, 3rem); }
  .meta { color: var(--ink-soft); margin-bottom: 1.1rem; }
  .join {
    display: flex; flex-direction: column; gap: .75rem; align-items: stretch; min-width: 260px;
    padding: 1.25rem; background: var(--petal-deep); border: 2px solid var(--ink);
  }
  .join .block { justify-content: center; }
  .row { display: flex; gap: .5rem; }
  .row .block { flex: 1; font-size: .98rem; padding: .5rem .7rem; }
  .store { display: inline-flex; align-items: center; justify-content: center; gap: .35rem; font-family: var(--font-ui); font-weight: 600; }
  @media (max-width: 820px) { .info { grid-template-columns: 1fr; } }
  .cols { display: grid; grid-template-columns: 3fr 2fr; gap: 3.5rem; margin-top: 3.5rem; }
  .cols p { max-width: 60ch; }
  .past { list-style: none; padding: 0; margin: 0; }
  .past li { padding: .7rem 0; border-top: 2px solid var(--ink); }
  @media (max-width: 820px) { .cols { grid-template-columns: 1fr; } }
</style>
