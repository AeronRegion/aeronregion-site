---
import { fmtDate, type Post } from '../lib/news';
const { post } = Astro.props as { post: Post };
---
<a href={`/news/${post.slug}/`} class="card news">
  {post.image && <img src={post.image} alt="" loading="lazy" />}
  <div class="body">
    <div class="meta">
      {post.tag && <span class="tag tag-accent">{post.tag}</span>}
      <time class="muted">{fmtDate(post.date)}</time>
    </div>
    <h3>{post.title}</h3>
    <p class="muted">{post.summary}</p>
  </div>
</a>

<style>
  .news { text-decoration: none; color: var(--text); display: flex; flex-direction: column; transition: border-color .15s, transform .15s; }
  .news:hover { border-color: var(--primary); transform: translateY(-2px); color: var(--text); }
  img { aspect-ratio: 16/9; object-fit: cover; width: 100%; }
  .body { padding: 1.2rem 1.3rem 1.4rem; }
  .meta { display: flex; gap: .6rem; align-items: center; font-size: .85rem; margin-bottom: .5rem; }
  h3 { font-size: 1.2rem; margin-bottom: .3rem; }
  p { margin: 0; font-size: .95rem; }
</style>
