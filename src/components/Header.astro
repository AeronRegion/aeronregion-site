---
import { site, nav, stores, socials, dexLink } from '../config/site';
import Icon from './Icon.astro';
const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
const discord = socials.find((s) => s.icon === 'discord');
---
<header class="site-header band">
  <div class="wrap bar">
    <a href="/" class="brand">
      <!-- LOGO: server icon + name. Swap the image in public/images/icon-96.png -->
      <img src="/images/icon-96.png" alt="" width="40" height="40" class="icon" />
      {site.name}
    </a>

    <button class="menu-btn" aria-label="Open menu" aria-expanded="false"><Icon name="menu" size={28} /></button>

    <nav class="nav">
      {nav.map((n) => n.items ? (
        <div class="dd">
          <button type="button" aria-haspopup="true" class:list={['link', { active: n.items.some((x) => isActive(x.href)) }]}>{n.label} <Icon name="chevron" size={16} /></button>
          <div class="menu left">{n.items.map((x) => <a href={x.href} aria-current={isActive(x.href) ? 'page' : undefined}>{x.label}</a>)}</div>
        </div>
      ) : (
        <a href={n.href} class:list={['link', { active: isActive(n.href!) }]} aria-current={isActive(n.href!) ? 'page' : undefined}>{n.label}</a>
      ))}
      <div class="dd">
        <button type="button" aria-haspopup="true" class="link">Shop <Icon name="chevron" size={16} /></button>
        <div class="menu">
          {stores.map((s) => <a href={s.href} target="_blank" rel="noopener">{s.label}</a>)}
        </div>
      </div>
      <a href={dexLink.href} class="outl">{dexLink.label} <span aria-hidden="true">↗</span></a>
      {discord && <a href={discord.href} class="block" target="_blank" rel="noopener"><Icon name="discord" size={18} /> Discord</a>}
    </nav>
  </div>
</header>

<script>
  const btn = document.querySelector('.menu-btn');
  const nav = document.querySelector('.nav');
  btn?.addEventListener('click', () => {
    const open = nav?.classList.toggle('open');
    btn.setAttribute('aria-expanded', String(!!open));
  });
  // Dropdowns open on hover (desktop) or tap; tapping elsewhere closes them.
  document.querySelectorAll<HTMLElement>('.dd > button').forEach((b) => b.addEventListener('click', () => {
    const box = b.parentElement!; const was = box.classList.contains('open');
    document.querySelectorAll('.dd.open').forEach((x) => x.classList.remove('open'));
    if (!was) box.classList.add('open');
  }));
  document.addEventListener('click', (e) => {
    document.querySelectorAll('.dd.open').forEach((d) => { if (!d.contains(e.target as Node)) d.classList.remove('open'); });
  });
</script>

<style>
  .site-header { position: sticky; top: 0; z-index: 50; background: var(--brick-deep); border-bottom: 3px solid #000; }
  .bar { display: flex; align-items: center; justify-content: space-between; height: 56px; width: min(100% - 2.5rem, 1280px); }
  .brand { display: flex; align-items: center; gap: .55rem; font-family: var(--font-pixel); font-size: 1.45rem; font-weight: 800; text-decoration: none; color: var(--on-brick); white-space: nowrap; }
  .nav { display: flex; align-items: center; gap: 1.25rem; }
  .link {
    font-family: var(--font-ui); font-weight: 700; font-size: 1.02rem; color: var(--on-brick);
    text-decoration: none; cursor: pointer; list-style: none; display: inline-flex; align-items: center; gap: .2rem; white-space: nowrap;
    height: 56px; padding: 0 .1rem; border-bottom: 3px solid transparent; margin-bottom: -3px;
  }
  .link::-webkit-details-marker { display: none; }
  .link:hover { color: #fff; }
  .link.active { color: #fff; border-bottom-color: #59c4fb; }
  .dd { position: relative; }
  .dd > button { font: inherit; font-family: var(--font-ui); font-weight: 700; font-size: 1.02rem; color: var(--on-brick); background: none; border: 0; border-bottom: 3px solid transparent; }
  .dd > button.active { color: #fff; border-bottom-color: #59c4fb; }
  .dd > .menu { display: none; }
  .dd.open > .menu, .dd:focus-within > .menu { display: grid; }
  @media (hover: hover) and (min-width: 1201px) { .dd:hover > .menu { display: grid; } }
  .outl { font-family: var(--font-ui); font-weight: 700; font-size: .92rem; color: var(--on-brick); text-decoration: none; padding: .32rem .8rem; border: 2px solid var(--brick); white-space: nowrap; }
  .outl:hover { background: var(--brick); color: #fff; }
  .menu {
    position: absolute; right: 0; top: 100%; min-width: 220px;
    background: #1d0c10; border: 2px solid #000; padding: .3rem; display: grid;
  }
  .menu a { padding: .5rem .8rem; text-decoration: none; color: var(--on-brick); font-weight: 600; }
  .menu.left { right: auto; left: -.8rem; }
  .menu a[aria-current='page'] { color: #fff; box-shadow: inset 3px 0 0 #59c4fb; }
  .menu a:hover { background: var(--brick); outline: 2px solid #fff; outline-offset: -2px; }
  .block { font-size: 1rem; padding: .4rem .9rem; }
  .icon { image-rendering: pixelated; }
  .menu-btn { display: none; background: none; border: 0; color: var(--on-brick); cursor: pointer; }

  @media (max-width: 1200px) {
    .menu-btn { display: block; }
    .nav {
      display: none; position: absolute; top: 59px; left: 0; right: 0;
      flex-direction: column; align-items: flex-start; gap: 1rem; padding: 1.25rem;
      background: var(--brick-deep); border-bottom: 3px solid #000;
    }
    .nav.open { display: flex; }
    .link { height: auto; margin-bottom: 0; }
    .menu { position: static; margin-top: .5rem; }
    .dd > .menu { display: grid; }
  }
</style>
