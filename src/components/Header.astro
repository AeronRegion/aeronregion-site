---
import { site, nav, stores, socials } from '../config/site';
import Icon from './Icon.astro';
const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
const discord = socials.find((s) => s.icon === 'discord');
---
<header class="site-header band">
  <div class="wrap bar">
    <a href="/" class="brand">
      <!-- LOGO: server icon + name. Swap the image in public/images/icon-96.png -->
      <img src="/images/icon-96.png" alt="" width="40" height="40" class="icon" />
      {site.name}
    </a>

    <button class="menu-btn" aria-label="Open menu" aria-expanded="false"><Icon name="menu" size={28} /></button>

    <nav class="nav">
      {nav.map((n) => (
        <a href={n.href} class:list={['link', { active: isActive(n.href) }]} aria-current={isActive(n.href) ? 'page' : undefined}>{n.label}</a>
      ))}
      <details class="shop">
        <summary class="link">Shop <Icon name="chevron" size={16} /></summary>
        <div class="menu">
          {stores.map((s) => <a href={s.href} target="_blank" rel="noopener">{s.label}</a>)}
        </div>
      </details>
      {discord && <a href={discord.href} class="block" target="_blank" rel="noopener"><Icon name="discord" size={18} /> Discord</a>}
    </nav>
  </div>
</header>

<script>
  const btn = document.querySelector('.menu-btn');
  const nav = document.querySelector('.nav');
  btn?.addEventListener('click', () => {
    const open = nav?.classList.toggle('open');
    btn.setAttribute('aria-expanded', String(!!open));
  });
  document.addEventListener('click', (e) => {
    document.querySelectorAll('details.shop[open]').forEach((d) => {
      if (!d.contains(e.target as Node)) d.removeAttribute('open');
    });
  });
</script>

<style>
  .site-header { position: sticky; top: 0; z-index: 50; border-bottom: 4px solid var(--brick-deep); }
  .bar { display: flex; align-items: center; justify-content: space-between; height: 64px; width: min(100% - 2.5rem, 1280px); }
  .brand { display: flex; align-items: center; gap: .55rem; font-family: var(--font-pixel); font-size: 1.45rem; font-weight: 800; text-decoration: none; color: var(--on-brick); white-space: nowrap; }
  .nav { display: flex; align-items: center; gap: 1.25rem; }
  .link {
    font-family: var(--font-ui); font-weight: 600; font-size: 1.08rem; color: var(--on-brick-soft);
    text-decoration: none; cursor: pointer; list-style: none; display: inline-flex; align-items: center; gap: .2rem; white-space: nowrap;
    padding: .2rem 0; border-bottom: 3px solid transparent;
  }
  .link::-webkit-details-marker { display: none; }
  .link:hover { color: var(--on-brick); }
  .link.active { color: var(--on-brick); border-bottom-color: var(--blossom); }
  .shop { position: relative; }
  .menu {
    position: absolute; right: 0; top: calc(100% + .7rem); min-width: 220px;
    background: var(--brick-deep); border: 2px solid #000; padding: .3rem; display: grid;
  }
  .menu a { padding: .5rem .7rem; text-decoration: none; color: var(--on-brick); }
  .menu a:hover { background: var(--brick); outline: 2px solid #fff; outline-offset: -2px; }
  .block { font-size: 1rem; padding: .4rem .9rem; }
  .icon { image-rendering: pixelated; }
  .menu-btn { display: none; background: none; border: 0; color: var(--on-brick); cursor: pointer; }

  @media (max-width: 1200px) {
    .menu-btn { display: block; }
    .nav {
      display: none; position: absolute; top: 68px; left: 0; right: 0;
      flex-direction: column; align-items: flex-start; gap: 1rem; padding: 1.25rem;
      background: var(--brick); border-bottom: 4px solid var(--brick-deep);
    }
    .nav.open { display: flex; }
    .menu { position: static; margin-top: .5rem; }
  }
</style>
