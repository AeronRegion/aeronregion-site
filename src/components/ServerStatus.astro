---
// Live player count + click-to-copy address, styled as a nametag plate.
// `ip` is what players see; `statusHost` is what gets pinged (via api.mcstatus.io).
import Icon from './Icon.astro';
const { ip, statusHost = '' } = Astro.props;
---
<div class="status pixel-corners" data-ip={ip} data-host={statusHost}>
  {statusHost && <span class="dot" aria-hidden="true"></span>}
  {statusHost && <span class="state">Checking server</span>}
  <button class="ip" type="button" aria-label={`Copy server address ${ip}`}>
    <span class="addr">{ip}</span>
    <Icon name="copy" size={16} />
  </button>
</div>

<script>
  document.querySelectorAll<HTMLElement>('.status[data-ip]').forEach(async (el) => {
    const ip = el.dataset.ip!;
    const host = el.dataset.host;
    const btn = el.querySelector('.ip')!;
    const addr = btn.querySelector('.addr')!;
    btn.addEventListener('click', async () => {
      await navigator.clipboard.writeText(ip);
      addr.textContent = 'Copied';
      setTimeout(() => (addr.textContent = ip), 1400);
    });
    if (!host) return;
    const state = el.querySelector('.state')!;
    try {
      const d = await (await fetch(`https://api.mcstatus.io/v2/status/java/${host}`)).json();
      if (d.online) {
        el.classList.add('online');
        const n = d.players?.online ?? 0;
        state.textContent = `${n} ${n === 1 ? 'player' : 'players'} online`;
      } else {
        el.classList.add('offline');
        state.textContent = 'Server offline';
      }
    } catch {
      state.textContent = 'Status unavailable';
    }
  });
</script>

<style>
  .status {
    display: inline-flex; align-items: center; gap: .75rem; flex-wrap: wrap;
    background: rgb(0 0 0 / .55); color: #fff;
    font-family: var(--font-ui); font-weight: 600; font-size: 1.05rem;
    padding: .45rem .5rem .45rem .9rem;
  }
  .dot { width: 10px; height: 10px; background: #9a9a9a; }
  .online .dot { background: var(--teal); box-shadow: 0 0 0 3px rgb(86 198 187 / .3); }
  .offline .dot { background: #e2687a; }
  .ip {
    display: inline-flex; align-items: center; gap: .5rem; cursor: pointer;
    font: inherit; color: var(--ink); background: #e8e2df;
    border: 2px solid #000; padding: .2rem .65rem;
    box-shadow: inset 2px 2px 0 #fff, inset -2px -2px 0 #9d9190;
  }
  .ip:hover { background: #fff; }
</style>
