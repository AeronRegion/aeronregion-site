---
import { site, socials, stores, nav } from '../config/site';
import Icon from './Icon.astro';
const year = new Date().getFullYear();
---
<footer class="band site-footer">
  <div class="wrap cols">
    <div>
      <div class="name">{site.name}</div>
      <div class="socials">
        {socials.map((s) => (
          <a href={s.href} target="_blank" rel="noopener" aria-label={s.label} title={s.label}><Icon name={s.icon} size={24} /></a>
        ))}
      </div>
    </div>
    <nav aria-label="Footer">
      {nav.slice(1).map((n) => <a href={n.href}>{n.label}</a>)}
    </nav>
    <nav aria-label="Stores">
      {stores.map((s) => <a href={s.href} target="_blank" rel="noopener">{s.label}</a>)}
    </nav>
  </div>
  <p class="wrap legal soft">© {year} {site.name}. Not an official Minecraft product. Not approved by or associated with Mojang or Microsoft.</p>
</footer>

<style>
  .site-footer { border-top: 4px solid var(--brick-deep); padding-top: 2.5rem; margin-top: 5rem; }
  .cols { display: grid; grid-template-columns: 2fr 1fr 1fr; gap: 2rem; }
  nav { display: flex; flex-direction: column; gap: .3rem; }
  nav a { text-decoration: none; color: var(--on-brick-soft); }
  nav a:hover { color: var(--on-brick); text-decoration: underline; }
  .name { font-family: var(--font-pixel); font-size: 1.4rem; font-weight: 400; }
  .socials { display: flex; gap: 1rem; margin-top: .8rem; }
  .socials a { color: var(--on-brick-soft); }
  .socials a:hover { color: var(--blossom); }
  .legal { font-size: .85rem; padding: 2rem 0 1.5rem; margin: 0 auto; }
  @media (max-width: 700px) { .cols { grid-template-columns: 1fr; } }
</style>
