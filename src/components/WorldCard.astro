---
import Icon from './Icon.astro';
import { downloadsBase } from '../config/site';
import type { World } from '../config/worlds';
const { world } = Astro.props as { world: World };
const href = `${downloadsBase}/${world.file}`;
---
<article class="card world">
  <div class="thumb">
    {world.image ? <img src={world.image} alt="" loading="lazy" /> : <div class="placeholder">{world.label}</div>}
    <span class="tag server">{world.server}</span>
  </div>
  <div class="body">
    <h3>{world.label}</h3>
    <p class="muted">{world.description}</p>
    <dl>
      <dt>Modpack</dt><dd>{world.packLink ? <a href={world.packLink} target="_blank" rel="noopener">{world.pack}</a> : world.pack}</dd>
      <dt>Minecraft</dt><dd>{world.mc}</dd>
      <dt>Ran</dt><dd>{world.period}</dd>
      {world.size && <><dt>Size</dt><dd>{world.size}</dd></>}
    </dl>
    {world.available
      ? <a class="btn btn-primary" href={href} download><Icon name="download" size={18} /> Download</a>
      : <span class="btn btn-ghost" aria-disabled="true">Coming soon</span>}
  </div>
</article>

<style>
  .world { display: flex; flex-direction: column; }
  .thumb { position: relative; aspect-ratio: 16/9; background: var(--surface-2); }
  .thumb img { width: 100%; height: 100%; object-fit: cover; object-position: center 70%; }
  .placeholder {
    height: 100%; display: grid; place-items: center; text-align: center; padding: 1rem;
    font-family: var(--font-display); font-weight: 800; font-size: 1.3rem; color: var(--primary);
    background: radial-gradient(circle at 30% 20%, var(--brick), var(--surface) 70%);
  }
  .server { position: absolute; top: .75rem; left: .75rem; background: rgb(0 0 0 / .6); }
  .body { padding: 1.3rem; display: flex; flex-direction: column; gap: .6rem; flex: 1; }
  h3 { margin: 0; font-size: 1.3rem; }
  p { margin: 0; }
  dl { display: grid; grid-template-columns: auto 1fr; gap: .25rem 1rem; margin: .3rem 0 .8rem; font-size: .92rem; }
  dt { color: var(--text-faint); }
  dd { margin: 0; }
  .btn { align-self: flex-start; margin-top: auto; }
</style>
