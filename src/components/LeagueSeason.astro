---
import TypeChip from './TypeChip.astro';
import { head, body, typeColors, type Season } from '../config/league';
import { dayMonth, year, toDate } from '../lib/dates';
const { season } = Astro.props as { season: Season };
const gyms = season.groups.flatMap((g) => g.leaders.map((l) => ({ ...l, group: g.name })));
const total = gyms.length;
const fmt = (iso: string) => `${dayMonth(toDate(iso))} ${year(toDate(iso))}`;
const onErr = "this.onerror=null;this.src='https://mc-heads.net/avatar/MHF_Steve/64'";
const stage = (c: Season['standings'][number]) => {
  if (c.champion) return 'League cleared';
  if ((c.e4 ?? 0) > 0 || c.badges.length >= total) return `Elite Four ${c.e4 ?? 0}/4`;
  const a = season.groups[0]?.leaders.map((l) => l.ign) ?? [];
  const aCount = c.badges.filter((b) => a.includes(b)).length;
  return season.groups.length > 1 && aCount >= a.length - 1 ? season.groups[1].name : season.groups[0].name;
};
// leader records from the battle log: leader wins - leader losses
const rec = new Map<string, [number, number]>();
for (const [, gym, , won] of season.matches ?? []) {
  const r = rec.get(gym) ?? [0, 0];
  r[won ? 1 : 0]++;
  rec.set(gym, r);
}
const log = [...(season.matches ?? [])].reverse();
const leaderOf = new Map(gyms.map((g) => [g.type, g.ign]));
const ranked = [...season.standings].sort((x, y) =>
  Number(!!y.champion) - Number(!!x.champion) || (y.e4 ?? 0) - (x.e4 ?? 0) || y.badges.length - x.badges.length);
---
<div class="season">
  <p class="dates">
    {season.status === 'current' ? `Started ${fmt(season.start)}` : `${fmt(season.start)} to ${fmt(season.end!)}`}
  </p>

  {season.victors.length > 0 && (
    <section class="victors">
      <h3>League victors</h3>
      <div class="stage">
        {season.victors.map((v) => (
          <figure>
            <img src={body(v)} alt="" width="80" height="160" loading="lazy" onerror={onErr} />
            <figcaption><span class="nametag">{v}</span></figcaption>
          </figure>
        ))}
      </div>
    </section>
  )}

  <section class="top">
    <h3>Champion and Elite Four</h3>
    <div class="stage">
      <figure class="champ">
        <img src={body(season.champion.ign, 200)} alt="" width="100" height="200" loading="lazy" onerror={onErr} />
        <figcaption>
          <span class="role">Champion</span>
          <span class="nametag">{season.champion.ign}</span>
          {season.champion.format && <span class="fmt">{season.champion.format}</span>}
        </figcaption>
      </figure>
      {season.elite4.map((e, i) => (
        <figure>
          <img src={body(e.ign)} alt="" width="80" height="160" loading="lazy" onerror={onErr} />
          <figcaption>
            <span class="role">Elite Four {i + 1}</span>
            <span class="nametag">{e.ign}</span>
            <TypeChip type={e.type} />
            {e.format && <span class="fmt">{e.format}</span>}
          </figcaption>
        </figure>
      ))}
    </div>
  </section>

  <section class="gyms">
    {season.groups.map((g) => (
      <div class="group">
        <h3>{g.name}</h3>
        {g.note && <p class="soft note">{g.note}</p>}
        <ol>
          {g.leaders.map((l) => (
            <li>
              <img src={head(l.ign, 48)} alt="" width="40" height="40" loading="lazy" onerror={onErr} />
              <span class="ign">{l.ign}</span>
              <TypeChip type={l.type} />
              <span class="fmt">{l.format}{rec.get(l.type) && <> <span class="rec" title="Leader record against challengers">{rec.get(l.type)![0]}W {rec.get(l.type)![1]}L</span></>}</span>
            </li>
          ))}
        </ol>
      </div>
    ))}
  </section>

  {ranked.length > 0 && (
    <section class="standings">
      <h3>Challenger standings</h3>
      {season.standingsAsOf && <p class="soft note">As of {fmt(season.standingsAsOf)}</p>}
      <div class="table">
        {ranked.map((c) => (
          <div class="row">
            <div class="who">
              <img src={head(c.ign, 48)} alt="" width="36" height="36" loading="lazy" onerror={onErr} />
              <span class="ign">{c.ign}</span>
            </div>
            <div class="pips" aria-label={`${c.badges.length} of ${total} badges`}>
              {gyms.map((gy) => (
                <span class:list={['pip', { on: c.badges.includes(gy.ign) }]}
                  style={`--c:${typeColors[gy.type] ?? typeColors.theme}`}
                  title={`${gy.type}: ${gy.ign}`}></span>
              ))}
              <span class="sep"></span>
              {[0, 1, 2, 3].map((k) => <span class:list={['pip e4', { on: (c.e4 ?? 0) > k }]} title={`Elite Four ${k + 1}`}></span>)}
            </div>
            <div class="count"><strong>{c.badges.length}</strong>/{total}</div>
            <div class="where">{stage(c)}</div>
          </div>
        ))}
      </div>
      <p class="soft legend">Each square is a gym badge, colored by type when earned. The last four are the Elite Four.</p>
    </section>
  )}

  {log.length > 0 && (
    <section class="log">
      <details>
        <summary><h3>Battle log</h3><span class="soft">{log.length} battles, newest first</span></summary>
        <table>
          <thead><tr><th>Date</th><th>Gym</th><th>Challenger</th><th>Result</th></tr></thead>
          <tbody>
            {log.map(([d, gym, who, won]) => (
              <tr>
                <td class="d">{dayMonth(toDate(d))}</td>
                <td><TypeChip type={gym} /> <span class="soft">{leaderOf.get(gym) ?? ''}</span></td>
                <td class="ign">{who}</td>
                <td class:list={['res', { win: won }]}>{won ? 'Badge earned' : 'Leader won'}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </details>
    </section>
  )}
</div>

<style>
  .season { display: flex; flex-direction: column; gap: 3rem; }
  .dates { font-family: var(--font-ui); font-weight: 700; color: var(--teal-ink); margin: 0 0 -2rem; }
  h3 { margin-bottom: .9rem; }
  .note { margin: -.6rem 0 .8rem; font-size: .95rem; }

  .stage {
    display: flex; flex-wrap: wrap; gap: 1.5rem 2.25rem; align-items: flex-end; justify-content: center;
    padding: 1.75rem 1.25rem 1.25rem;
    background: linear-gradient(180deg, #f9e8e5 0%, var(--petal-deep) 100%);
    border: 2px solid var(--ink); border-bottom-width: 6px;
  }
  figure { margin: 0; display: flex; flex-direction: column; align-items: center; gap: .5rem; text-align: center; width: 128px; }
  figure img { image-rendering: pixelated; filter: drop-shadow(0 6px 0 rgb(46 26 32 / .18)); }
  .champ { width: 160px; }
  figcaption { display: flex; flex-direction: column; align-items: center; gap: .3rem; }
  .role { font-family: var(--font-ui); font-weight: 700; font-size: .8rem; color: var(--ink-soft); }
  figcaption .nametag { font-family: var(--font-ui); font-weight: 700; font-size: .95rem; background: rgb(0 0 0 / .6); }
  .champ .nametag { font-size: 1.1rem; }
  .fmt { font-size: .8rem; color: var(--ink-soft); }

  .gyms { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 2.5rem; }
  .group ol { list-style: none; margin: 0; padding: 0; }
  .group li {
    display: grid; grid-template-columns: 40px 1fr auto; grid-template-rows: auto auto; column-gap: .8rem;
    align-items: center; padding: .55rem 0; border-top: 2px solid var(--ink);
  }
  .group li:last-child { border-bottom: 2px solid var(--ink); }
  .group li img { grid-row: 1 / span 2; image-rendering: pixelated; border: 2px solid var(--ink); }
  .ign { font-family: var(--font-ui); font-weight: 700; font-size: 1.05rem; }
  .group li .fmt { grid-column: 2 / span 2; }

  .table { border: 2px solid var(--ink); }
  .row {
    display: grid; grid-template-columns: minmax(150px, 200px) 1fr auto 7.5rem; gap: 1rem; align-items: center;
    padding: .6rem .9rem; border-top: 2px solid var(--ink);
  }
  .row:first-child { border-top: 0; }
  .row:nth-child(odd) { background: #f9e8e5; }
  .who { display: flex; align-items: center; gap: .6rem; }
  .who img { image-rendering: pixelated; border: 2px solid var(--ink); }
  .pips { display: flex; flex-wrap: wrap; gap: 4px; align-items: center; }
  .pip { width: 16px; height: 16px; border: 2px solid rgb(46 26 32 / .35); background: transparent; }
  .pip.on { background: var(--c); border-color: var(--ink); }
  .pip.e4.on { background: var(--blossom); }
  .sep { width: 8px; }
  .count { font-family: var(--font-ui); }
  .count strong { font-size: 1.2rem; }
  .where { font-family: var(--font-ui); font-weight: 600; font-size: .9rem; color: var(--teal-ink); text-align: right; }
  .legend { font-size: .9rem; margin-top: .6rem; }
  .rec { font-family: var(--font-ui); font-weight: 600; color: var(--ink); margin-left: .4rem; }

  .log summary { display: flex; align-items: baseline; gap: 1rem; cursor: pointer; list-style: none; }
  .log summary::-webkit-details-marker { display: none; }
  .log summary h3 { margin: 0; }
  .log summary::after { content: 'Show'; margin-left: auto; font-family: var(--font-ui); font-weight: 700; text-decoration: underline; }
  .log details[open] summary::after { content: 'Hide'; }
  .log table { width: 100%; border-collapse: collapse; margin-top: 1rem; font-size: .95rem; }
  .log th { text-align: left; font-family: var(--font-ui); color: var(--ink-soft); padding: .4rem .6rem; border-bottom: 2px solid var(--ink); }
  .log td { padding: .4rem .6rem; border-bottom: 1px solid rgb(46 26 32 / .2); }
  .log .d { font-family: var(--font-ui); font-weight: 700; white-space: nowrap; }
  .log .res { font-family: var(--font-ui); font-weight: 600; color: var(--ink-soft); }
  .log .res.win { color: var(--teal-ink); }

  @media (max-width: 760px) {
    .row { grid-template-columns: 1fr auto; }
    .pips { grid-column: 1 / -1; grid-row: 2; }
    .where { grid-column: 1 / -1; text-align: left; }
  }
</style>
